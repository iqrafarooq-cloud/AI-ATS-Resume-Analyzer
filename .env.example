# Required for AI analysis. Without it, ResumePilot uses its built-in rule-based checks only.
AI_API_KEY=

# Optional. groq (default) | openai | openai-compatible
AI_PROVIDER=groq

# Optional. Defaults: groq -> openai/gpt-oss-120b, openai -> gpt-5-mini
AI_MODEL=

# Optional. Only needed when AI_PROVIDER=openai-compatible.
AI_BASE_URL=

# Optional. Max AI requests at once (default 1 for groq to stay within free-tier limits, 4 otherwise).
AI_CONCURRENCY=
